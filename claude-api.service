[Unit]
Description=Claude Excel API - Integração Claude AI com Excel
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/claude-api
EnvironmentFile=/etc/claude-api.env
ExecStart=/opt/claude-api/.venv/bin/python api_server.py
Restart=on-failure
RestartSec=5s

# Segurança básica
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
